# Polsia OS — environment configuration (12-factor; never commit real secrets)

# Application
POLSIA_ENV=development
POLSIA_LOG_LEVEL=INFO

# Database (PostgreSQL in production; SQLite for local no-docker dev/tests)
POLSIA_DATABASE_URL=postgresql+asyncpg://polsia:polsia@localhost:5432/polsia
# POLSIA_DATABASE_URL=sqlite+aiosqlite:///./polsia_dev.db

# Auth (HS256 keys must be >= 32 bytes outside development)
POLSIA_JWT_SECRET=change-me-generate-a-random-secret-of-at-least-32-bytes
POLSIA_JWT_ALGORITHM=HS256
POLSIA_ACCESS_TOKEN_TTL_MINUTES=30
POLSIA_REFRESH_TOKEN_TTL_DAYS=14

# Events
POLSIA_EVENT_BUS=inprocess
